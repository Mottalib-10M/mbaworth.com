---
/** Every tool, ranking, sector or guide page (src/content/pages/) and every school page (src/content/schools/). */
import ContentPage from '../../components/ContentPage.astro';
import SchoolPage from '../../components/SchoolPage.astro';
import { PAGES, SCHOOL_PAGES } from '../../lib/pages';
import type { PageDef, SchoolDef } from '../../lib/page-types';
export function getStaticPaths() {
  return [
    ...PAGES.map((page) => ({ params: { slug: page.slug }, props: { page, school: undefined } })),
    ...SCHOOL_PAGES.map((school) => ({ params: { slug: `schools/${school.slug}` }, props: { page: undefined, school } })),
  ];
}
const { page, school } = Astro.props as { page?: PageDef; school?: SchoolDef };
---
{page ? <ContentPage page={page} /> : <SchoolPage def={school!} />}
