---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of AdmitCost about an admit rate, a net price, a Common Data Set we missed or the embed code. We answer data questions, not application advice.';
---
<PageLayout title="Contact AdmitCost: corrections, newer data and embed questions" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>E-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form: the site never asks for a name, a phone number or a graduation year.</p>
    <h2>What we can help with</h2>
    <ul>
      <li>A figure that looks wrong: send the university, the figure and, if you have it, the link to the official document that says otherwise.</li>
      <li>A university that published its new Common Data Set or class profile: we read it and update the page with the new cycle and its date.</li>
      <li>Putting the odds and net price calculator on your own site: see the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not review essays, advise on where to apply, negotiate aid or recommend consultants. For your exact price, each university page links to that school's own net price calculator, which federal law requires every college to post.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
