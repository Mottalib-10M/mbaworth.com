---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of MBA Worth about a fee, a salary or an employment report we missed, or about the embed code. We answer questions on figures, not on applications.';
---
<PageLayout title="Contact MBA Worth: a figure to fix, a new report or the embed" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>E-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no newsletter: the site never asks for your name, your GMAT score or your intake.</p>
    <h2>Useful messages</h2>
    <ul>
      <li>A figure that looks wrong: name the school and the figure, and add the link to the school's document if you have it.</li>
      <li>A school that has released a new employment report or new fees: we read it and update its page with the class and the date.</li>
      <li>A school you would like to see added: tell us which one; it needs a public fees page and a public employment report.</li>
      <li>Embedding the return calculator: see the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we do not do</h2>
    <p>We do not review essays or CVs, predict admission, negotiate scholarships or recommend consultants. For a binding cost, the school's financial aid office and your offer letter are the references.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
