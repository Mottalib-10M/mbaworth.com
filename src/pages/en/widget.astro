---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/odds-net-price/" title="College odds and net price calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the college odds and net price calculator, free of charge" description="Put the AdmitCost calculator on a school counseling page or a blog with one iframe line: admit rate, score position and net price by income for 110 universities, no cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a university publishes a new cycle or the College Scorecard is updated, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Useful for high school counseling offices, college access programs, local newsrooms and family finance blogs. Terms: keep the credit link under the calculator visible, do not alter the frame, and present the result as an average, not an offer. The frame sets no cookie and tells us nothing about your visitors. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/odds-net-price/" title="College odds and net price calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
