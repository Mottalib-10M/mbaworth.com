---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/mba-return/" title="MBA return calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the MBA return calculator on your site, free of charge" description="Put the MBA Worth calculator on a career blog or an alumni page with one iframe line: total cost, payback and ten-year value for each business school, no cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a school publishes new fees or a new employment report, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Useful for career services, alumni clubs, admissions blogs and personal finance writers. Terms: keep the credit link under the calculator visible, do not alter the frame, and present the result as a model built on past classes, not an offer. The frame sets no cookie and tells us nothing about your visitors. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/mba-return/" title="MBA return calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
