---
/** Renders the tool of a page with the figures it needs (prepared in lib/props.ts) as a hydrated island. */
import RoiCalc from './calc/RoiCalc';
import FinderBoard from './calc/FinderBoard';
import CompareCalc from './calc/CompareCalc';
import CaseCalc from './calc/CaseCalc';
import BlsCalc from './calc/BlsCalc';
import ProjectCalc from './calc/ProjectCalc';
import { common, BLS } from '../lib/props';
import type { ToolKind, ToolArgs } from '../lib/page-types';
interface Props { kind: ToolKind; args?: ToolArgs; lock?: boolean; idPrefix?: string }
const { kind, args = {}, lock = false, idPrefix } = Astro.props;
const c = common();
const school = args.school && c.schools.some((s) => s.slug === args.school) ? args.school : (c.schools.find((s) => s.slug === 'wharton') ?? c.schools[0]).slug;
const pair = (args.schools ?? []).filter((s) => c.schools.some((x) => x.slug === s));
const defaults = pair.length >= 2 ? pair : c.schools.slice(0, 3).map((s) => s.slug);
---
{(kind === 'roi' || kind === 'cost' || kind === 'payback' || kind === 'worth') && <RoiCalc client:load {...c} school={school} lock={lock} goal={args.goal ?? 'all'} mode={kind === 'roi' ? 'full' : kind} idPrefix={idPrefix} />}
{(kind === 'finder' || kind === 'salary') && <FinderBoard client:load {...c} goal={args.goal ?? (kind === 'salary' ? 'all' : 'consulting')} length={args.length ?? 'any'} where={args.where ?? 'any'} sort={kind === 'salary' ? 'salary' : 'fit'} idPrefix={idPrefix} />}
{kind === 'compare' && <CompareCalc client:load {...c} defaults={defaults} goal={args.goal ?? 'all'} idPrefix={idPrefix} />}
{kind === 'case' && <CaseCalc client:load mode={(args.mode as 'sizing') ?? 'sizing'} methodHref={c.methodHref} idPrefix={idPrefix} />}
{kind === 'bls' && <BlsCalc client:load occs={BLS.occupations} metro={BLS.managementAnalystsByMetro} occ={args.mode ?? '131111'} period={BLS.period} methodHref={c.methodHref} idPrefix={idPrefix} />}
{kind === 'project' && <ProjectCalc client:load methodHref={c.methodHref} idPrefix={idPrefix} />}
