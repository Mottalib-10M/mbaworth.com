---
/**
 * A tool, ranking, sector or guide page of `src/content/pages/`: H1, one line of answer, the tool first,
 * the folded answer, then the body with its mini-simulators. FAQ (shown and marked up from one list),
 * related pages, sources and publisher: PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import BandArt from './BandArt.astro';
import { route, ROUTES } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { helpers, SOURCES } from '../lib/helpers';
import { schoolBySlug } from '../lib/data';
import { card } from '../lib/cards';
import { PAGES } from '../lib/pages';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME, LAST_UPDATED } from '../data/site-config';
import { day } from '../lib/fmt';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const group = GROUPS.find((g) => g.id === page.group)!;
const parts = page.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const jsonLd = [webApplicationSchema({ name: page.h1, description: page.description, path, lang }), articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
const docs: Array<{ name: string; url: string }> = [];
for (const slug of page.schoolSources ?? []) {
  const s = schoolBySlug(slug);
  for (const [n, u] of [['employment report', s.emp.url], ['fees', s.tuition?.url], ['student budget', s.living?.url]] as const) if (u && !docs.some((d) => d.url === u)) docs.push({ name: `${s.short}: ${n}`, url: u });
}
const sources = [...page.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url })), ...(page.extSources ?? []).map((x) => ({ name: x.label, url: x.url })), ...docs];
const parent = page.slug.includes('/') ? PAGES.find((x) => x.id === page.slug.split('/')[0]) : undefined;
const crumbs = parent ? [{ label: parent.nav, href: route(parent.id, lang) }, { label: page.nav }] : [{ label: group.label }, { label: page.nav }];
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={crumbs} anneeEnHaut={!/20\d\d/.test(page.h1 + page.intro)} masthead>
  <article>
    <header class="band pb-16 pt-3">
      <BandArt />
      <div class="relative">
      <p class="eyebrow">{group.label} · figures from each school’s own report</p>
      <h1 class="mt-2 font-serif text-[1.75rem] leading-[1.12] sm:text-4xl md:text-[2.6rem]">{page.h1}</h1>
      <p class="band-intro mt-3 max-w-4xl text-base sm:text-lg">{page.intro}</p>
      </div>
    </header>
    <div data-outil data-chrome class="hero-tool mb-4"><Tool kind={page.tool} args={page.toolArgs} idPrefix={page.id.replace(/[^a-z]/g, '').slice(0, 6)} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · figures checked <time datetime={LAST_UPDATED}>{day(LAST_UPDATED)}</time> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a></p>
    <Clamp text={page.resume} lang={lang} id={`clamp-${page.id.replace(/\//g, '-')}`} class="mb-8" />
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={route('home', lang)} /> : null)}
    </div>
  </article>
</PageLayout>
