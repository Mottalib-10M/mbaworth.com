---
/**
 * Décor du bandeau de tête (2026-10-15) : une courbe de retour sur investissement dessinée à la main —
 * le coût cumulé plonge pendant le programme, remonte et croise la ligne zéro (le remboursement).
 * Purement décoratif (aria-hidden), masqué sous 1024 px, aucune donnée réelle.
 */
---
<svg class="band-art" viewBox="0 0 560 300" preserveAspectRatio="xMaxYMax meet" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ba-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#ffffff" stroke-opacity=".06" /></pattern>
    <linearGradient id="ba-fade" x1="0" x2="1"><stop offset="0" stop-color="#0e1626" /><stop offset=".35" stop-color="#0e1626" stop-opacity="0" /></linearGradient>
  </defs>
  <rect width="560" height="300" fill="url(#ba-grid)" />
  <line x1="40" y1="150" x2="560" y2="150" stroke="#dcc08a" stroke-opacity=".55" stroke-dasharray="3 5" />
  <path d="M40 150 C 80 150, 100 236, 150 244 S 230 232, 270 196 S 360 120, 420 86 S 520 40, 560 30" fill="none" stroke="#7fb9b0" stroke-width="2.2" />
  <path d="M40 150 C 80 150, 100 236, 150 244 S 230 232, 270 196 S 360 120, 420 86 S 520 40, 560 30 L 560 300 L 40 300 Z" fill="#7fb9b0" fill-opacity=".05" />
  <circle cx="332" cy="150" r="5" fill="#0e1626" stroke="#dcc08a" stroke-width="2" />
  <line x1="332" y1="150" x2="332" y2="290" stroke="#dcc08a" stroke-opacity=".35" />
  <rect width="560" height="300" fill="url(#ba-fade)" />
</svg>
