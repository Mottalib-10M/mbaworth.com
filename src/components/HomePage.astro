---
/**
 * Home, in its own order for this subject: the return calculator first (any school, no account), then
 * "the best school for your goal" in six short cards computed on our ranking, the folded answer, one table
 * of every school (cost, salary, payback), the three careers, the long text in accordions, the FAQ.
 * Text: src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { HOME } from '../content/home';
import { route } from '../i18n/routes';
import { helpers, SOURCES, table, schoolLink } from '../lib/helpers';
import { PAGES } from '../lib/pages';
import { SCHOOLS, MODEL } from '../lib/data';
import { KIT } from '../lib/kit';
import { GOAL_LIST } from '../lib/goals';
import { usd, p, yrs, day, money, kindLabel } from '../lib/fmt';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, YEAR } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const sections = x.sections(h);
const CARDS = ['consulting', 'ib', 'pe', 'tech', 'z-europe', 'z-asia'];
const bestPage = (g: string) => PAGES.find((pg) => pg.group === 'best' && pg.toolArgs?.goal === g && !pg.toolArgs?.length && !pg.toolArgs?.where);
const cards = CARDS.map((g) => ({ g: GOAL_LIST.find((y) => y.id === g)!, top: KIT.top(g, 3), pg: bestPage(g) })).filter((c) => c.top.length);
const topInd = (s: (typeof SCHOOLS)[number]) => { const r = [...s.emp.industries].sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0))[0]; return r && r.pct !== null ? `${r.key} ${p(r.pct)}` : 'n/a'; };
const rows = [...SCHOOLS].filter((s) => s.tuition).sort((a, b) => a.short.localeCompare(b.short)).map((s) => { const o = KIT.roi(s.slug); return [schoolLink(s.slug), s.months ? String(s.months) : 'n/a', o ? usd(o.total) : 'n/a', s.emp.salary ? `${money(s.emp.salary.v, s.emp.salary.cur)}${/mean/.test(s.emp.salary.kind) ? ' avg' : ''}` : 'n/a', o ? (o.payback === null ? 'over 30 y' : yrs(o.payback)) : 'n/a', topInd(s)]; });
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-1 text-sm text-navy-600">{YEAR} figures · <a href={route('method', lang)} class="underline">Method</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="roi" args={{ school: 'wharton' }} idPrefix="home" /></div>
  <section class="my-8" data-chrome>
    <h2 class="font-serif text-xl font-bold text-navy-900">The best school for your goal, on our numbers</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (
        <div class="rounded-lg border border-navy-200 p-4">
          <p class="font-semibold text-navy-900">{c.pg ? <a class="text-accent-700 underline-offset-2 hover:underline" href={route(c.pg.id, lang)}>{c.g.label}</a> : c.g.label}</p>
          <ol class="mt-2 space-y-1 text-sm text-navy-800">{c.top.map((r) => <li class="tabular-nums"><span class="font-semibold">{r.rank}.</span> <Fragment set:html={schoolLink(r.slug)} /> · {p(r.share)} of the class · {usd(r.salary)}{r.fallback ? '*' : ''}</li>)}</ol>
        </div>
      ))}
    </div>
    <p class="mt-2 text-xs text-navy-600">Fit score on the share of the class placed, the salary reported and the ten-year NPV for a person earning {usd(MODEL.refSalary)} today. * school-wide salary. <a class="underline" href={route('mba-finder', lang)}>Rank every school on your own goal and salary</a>.</p>
  </section>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="prose prose-slate max-w-none prose-headings:font-serif">
    <h2>{x.tableTitle}</h2>
    <Fragment set:html={x.tableIntro(h)} />
  </section>
  <div data-chrome class="max-h-[40rem] overflow-auto">
    <Fragment set:html={table(['School', 'Months', 'Total cost', 'Salary', 'Payback', 'Largest industry'], rows, `Total cost and payback for a person earning ${usd(MODEL.refSalary)} before the MBA (salary given up included), US dollars at the ECB rate of ${day(KIT.FX_DATE)}. Salary in the school's currency, median unless marked avg.`, ['l', 'r', 'r', 'r', 'r', 'l'])} />
  </div>
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {sections.map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="prose prose-slate max-w-none pb-4"><Fragment set:html={s.html} /></div></details>)}
  </section>
</PageLayout>
