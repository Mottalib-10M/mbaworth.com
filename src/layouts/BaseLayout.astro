---
import { displayDate } from '../lib/format';
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import { consentStrings } from '../data/consent-strings';
import { SITE_URL, YEAR, LAST_UPDATED, BING_VERIFY_CODE, GOOGLE_VERIFY_CODE, CONSENT_MODE, GA4_ID, CLARITY_ID, THEME_COLOR, AUTHOR_NAME, SITE_NAMES, LANG_TAGS, OG_LOCALES, LOGO_SYMBOL } from '../data/site-config';
import { t } from '../i18n/ui';
import { altPaths, route, LOCALES, DEFAULT_LOCALE, type Locale } from '../i18n/routes';
import { navCategories, navDirect, footerColumns, popularLinks } from '../i18n/nav';

interface BreadcrumbItem { label: string; href?: string }
interface Props { title: string; description: string; lang: Locale; canonical?: string; ogImage?: string; noindex?: boolean; jsonLd?: string[]; breadcrumbs?: BreadcrumbItem[]; masthead?: boolean }
const { title, description, lang, canonical, ogImage, noindex = false, jsonLd = [], breadcrumbs = [], masthead = false } = Astro.props;
const ui = t(lang);
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? `${SITE_URL}${pathname}`;
const ogImageUrl = ogImage ?? `${SITE_URL}/og-${lang}.png`;
const alts = altPaths(pathname);
const homeHref = route('home', lang);
const cats = navCategories(lang); const direct = navDirect(lang); const footerCols = footerColumns(lang); const popular = popularLinks(lang);
const otherLocales = LOCALES.filter((l) => l !== lang);
const here = (href: string) => href === pathname;
const chev = '<svg class="chev" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>';
// Un emplacement passé sous condition compte comme présent pour Astro.slots.has : on regarde ce
// qu'il rend, sinon une rangée vide s'ajoute au-dessus du titre (trame, RECETTE §10.3).
const slotDate = Astro.slots.has('crumb-aside') ? (await Astro.slots.render('crumb-aside')).trim() : '';
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta name="author" content={AUTHOR_NAME} />
    {BING_VERIFY_CODE && <meta name="msvalidate.01" content={BING_VERIFY_CODE} />}
    {GOOGLE_VERIFY_CODE && <meta name="google-site-verification" content={GOOGLE_VERIFY_CODE} />}
    {alts && LOCALES.length > 1 && (<>
      {LOCALES.map((l) => <link rel="alternate" hreflang={LANG_TAGS[l]} href={`${SITE_URL}${alts[l]}`} />)}
      <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alts[DEFAULT_LOCALE]}`} />
    </>)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:site_name" content={SITE_NAMES[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Le .ico reste necessaire : plusieurs agregateurs et le collecteur de
         favicons de Google le demandent a la racine avant de lire le HTML. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={ld} />)}
    {/* GA4, régime 'none' (décision de l'éditeur du 2026-10-17, RECETTE §15.6) : Google Analytics 4
         normal, avec cookies, SANS bandeau. Consentement par défaut : mesure d'audience accordée
         (analytics_storage 'granted'), publicité refusée (ad_storage, ad_user_data, ad_personalization
         'denied'), aucune lecture de localStorage. Cookies _ga et _ga_<ID> limités à 390 jours
         (13 mois au plus, recommandation CNIL) et non prolongés à chaque visite (cookie_update false) ;
         signaux Google et personnalisation publicitaire coupés. Les pages légales le disent
         (scripts/gen-legal-pages.py). L'adresse envoyée à GA4 est sans paramètres (page_location) : les
         saisies qu'un lien de partage porte dans l'adresse ne partent pas chez Google. Contrôle :
         check-cookies.py. */}
    {GA4_ID && CONSENT_MODE === 'none' && (<>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('consent','default',{analytics_storage:'granted',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',functionality_storage:'granted',security_storage:'granted'});`} />
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline set:html={`gtag('js',new Date());gtag('config','${GA4_ID}',{anonymize_ip:true,page_location:location.origin+location.pathname,cookie_expires:33696000,cookie_update:false,allow_google_signals:false,allow_ad_personalization_signals:false});`} />
    </>)}
    {/* Régimes 'opt-in' / 'notice' (anciens) : GA4 suit le choix enregistré dans consent-choice. */}
    {GA4_ID && CONSENT_MODE !== 'none' && (<>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;(function(){var d='${CONSENT_MODE === 'opt-in' ? 'denied' : 'granted'}';var c=null;try{c=localStorage.getItem('consent-choice');}catch(e){}var v=(c==='granted'||(c===null&&d==='granted'))?'granted':'denied';gtag('consent','default',{ad_storage:v,analytics_storage:v,ad_user_data:v,ad_personalization:v,functionality_storage:'granted',security_storage:'granted',wait_for_update:500});})();`} />
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline set:html={`gtag('js',new Date());gtag('config','${GA4_ID}',{anonymize_ip:true});`} />
    </>)}
    {/* Régime 'none' (règle du 2026-10-06, RECETTE §15.6) : aucun bandeau, aucun cookie.
         Clarity est chargé en mode sans consentement : le signal consentv2 « denied » est mis
         en file AVANT le script, donc Clarity ne pose aucun cookie (_clck, _clsk, MUID, CLID),
         donne un identifiant par page vue et ne relie pas les sessions. Mesure technique et
         anonyme de la stabilité (erreurs, performances, clics inopérants), contenu masqué. */}
    {CLARITY_ID && CONSENT_MODE === 'none' && (
      <script is:inline set:html={`(function(){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'denied'});var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/${CLARITY_ID}';document.head.appendChild(s);})();`} />
    )}
    {/* Régimes 'opt-in' / 'notice' (anciens) : Clarity ne se charge qu'avec un choix favorable
         (ou par défaut en 'notice'). Sans cela, seule une file d'attente vide existe. */}
    {CLARITY_ID && CONSENT_MODE !== 'none' && (
      <script is:inline set:html={`(function(){var d='${CONSENT_MODE === 'opt-in' ? 'denied' : 'granted'}';var c=null;try{c=localStorage.getItem('consent-choice');}catch(e){}window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.__clarityLoad=function(){if(window.__clarityOn)return;window.__clarityOn=true;var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/${CLARITY_ID}';document.head.appendChild(s);};if(c==='granted')window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'granted'});if(c==='granted'||(c===null&&d==='granted'))window.__clarityLoad();})();`} />
    )}
  </head>
  <body class="min-h-screen text-navy-900 antialiased" data-clarity-mask="true">
    <a href="#main-content" class="skip-link">{ui.skipToContent}</a>
    <header>
    <nav class="site-head fixed top-0 z-50 w-full" aria-label={ui.mainNav}>
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
        <a href={homeHref} class="brand flex shrink-0 items-center gap-2.5">
          <img src="/logo.svg" class="h-8 w-8" width="32" height="32" alt="" />
          <span>{SITE_NAMES[lang]}</span>
        </a>
        <ul class="hidden items-center gap-0.5 lg:flex" role="list">
          {cats.map((cat, idx) => (
            <li class="nav-dropdown">
              <button type="button" class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-controls={`nav-panel-${idx}`} aria-current={cat.links.some((l) => here(l.href)) ? 'true' : undefined}>
                {cat.label}<Fragment set:html={chev} />
              </button>
              <div id={`nav-panel-${idx}`} style={cat.links.length > 8 ? `--rows:${Math.ceil(cat.links.length / 2)}` : undefined} class={`nav-panel ${cat.links.length > 8 ? 'cols-2' : ''} ${idx >= cats.length - 2 ? 'right-0' : 'left-0'}`}>
                {cat.links.map((l) => <a href={l.href} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a>)}
              </div>
            </li>
          ))}
          {direct.map((l) => <li><a href={l.href} class="nav-link" aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
          {otherLocales.map((l) => <li><a href={alts ? alts[l] : route('home', l)} hreflang={l} class="nav-link ml-2 border border-white/20 text-xs uppercase">{l}</a></li>)}
        </ul>
        <div class="flex items-center gap-2 lg:hidden">
          {otherLocales.map((l) => <a href={alts ? alts[l] : route('home', l)} class="nav-link border border-white/20 text-xs uppercase">{l}</a>)}
          <button type="button" id="mobile-menu-toggle" class="burger" aria-label={ui.menuOpen} aria-expanded="false" aria-controls="mobile-menu">
            <svg class="bars h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="x h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.8" d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain px-4 pb-6 lg:hidden">
        {cats.map((cat, idx) => (
          <div class="border-b border-navy-200">
            <button type="button" class="mobile-section-toggle flex w-full items-center justify-between py-3.5 text-left font-serif text-lg font-semibold" aria-expanded="false" aria-controls={`m-sec-${idx}`}>{cat.label}<svg class="mobile-chevron h-4 w-4 text-navy-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button>
            <div id={`m-sec-${idx}`} class="mobile-section-content hidden pb-3">{cat.links.map((l) => <a href={l.href} aria-current={here(l.href) ? 'page' : undefined} class="block border-l border-navy-200 py-2 pl-4 text-[0.95rem] hover:border-accent-500">{l.label}</a>)}</div>
          </div>
        ))}
        {direct.map((l) => <div class="border-b border-navy-200"><a href={l.href} aria-current={here(l.href) ? 'page' : undefined} class="block py-3.5 font-serif text-lg font-semibold">{l.label}</a></div>)}
      </div>
    </nav>
    </header>
    <main id="main-content" class="pt-16">
      {(breadcrumbs.length > 0 || slotDate) && (
        <div class={masthead ? 'band crumbs-band' : ''}><div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 px-4 pt-3">{breadcrumbs.length > 0 && <nav aria-label={ui.breadcrumbLabel}>
          <ol class={`flex flex-wrap items-center gap-1 text-sm ${masthead ? '' : 'text-navy-600'}`}>
            <li><a href={homeHref} class="hover:underline">{ui.breadcrumbHome}</a></li>
            {breadcrumbs.map((item) => (<li class="flex items-center gap-1"><span aria-hidden="true" class="opacity-60">/</span>{item.href ? <a href={item.href} class="hover:underline">{item.label}</a> : <span class={masthead ? '' : 'text-navy-800'} aria-current="page">{item.label}</span>}</li>))}
          </ol>
        </nav>}{slotDate && <Fragment set:html={slotDate} />}</div></div>
      )}
      <slot />
    </main>
    <footer class="site-foot mt-20">
      <div class="mx-auto max-w-6xl px-4 pb-10 pt-14">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_3fr]">
          <div>
            <a href={homeHref} class="brand inline-flex items-center gap-2.5"><img src="/logo.svg" class="h-9 w-9" width="36" height="36" alt="" /><span>{SITE_NAMES[lang]}</span></a>
            <p class="foot-muted mt-4 max-w-xs text-sm leading-relaxed">{ui.footerBrowser}</p>
          </div>
          <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
            {footerCols.map((col) => (<div><h2 class="mb-4">{col.label}</h2><ul class="space-y-2 text-sm">{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>))}
          </div>
        </div>
        {popular.length > 0 && (<div class="foot-rule mt-12 border-t pt-6"><h2 class="mb-3">{ui.footerPopular}</h2><p class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm">{popular.map((p) => <a href={p.href}>{p.label}</a>)}</p></div>)}
        <div class="foot-rule mt-10 border-t pt-8">
          <div class="foot-muted flex flex-col items-center gap-2 text-center text-sm">
            <p><span class="badge-ok inline-flex items-center gap-2 rounded-full px-3 py-0.5 text-xs font-medium"><span class="inline-block h-1.5 w-1.5 rounded-full bg-brass-300" aria-hidden="true"></span>{ui.footerValidated} · {YEAR}</span></p>
            <p>{ui.asOf} {YEAR}, {ui.lastUpdated} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, LANG_TAGS[lang])}</time></p>
            <p class="max-w-3xl">&copy; {new Date().getFullYear()} {SITE_NAMES[lang]}. {ui.footerDisclaimer}</p>
            {(GA4_ID || CLARITY_ID) && CONSENT_MODE !== 'none' && <p><button type="button" data-consent-manage class="underline">{consentStrings(lang).manage}</button></p>}
          </div>
        </div>
      </div>
    </footer>
    <script>
      /* Menu (2026-10-15). Défaut corrigé : le survol ouvrait le panneau et le clic qui suivait sur le même
         bouton le refermait aussitôt ; sur tablette, le toucher déclenche les deux et le menu ne s'ouvrait
         jamais. Désormais : survol à la souris seulement, clic = ouvrir/fermer selon l'état réel, aria-expanded
         tenu à jour, Échap, flèches et sortie du focus referment. */
      const dds = [...document.querySelectorAll<HTMLElement>('.nav-dropdown')];
      const trig = (dd: HTMLElement) => dd.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')!;
      const links = (dd: HTMLElement) => [...dd.querySelectorAll<HTMLAnchorElement>('.nav-panel a')];
      const close = (dd: HTMLElement) => { delete dd.dataset.open; delete dd.dataset.hover; trig(dd).setAttribute('aria-expanded', 'false'); };
      // Le panneau s'aligne à gauche du bouton, ou à droite s'il sortirait de l'écran.
      const place = (dd: HTMLElement) => { const pn = dd.querySelector<HTMLElement>('.nav-panel'); if (!pn) return; pn.style.left = '0'; pn.style.right = 'auto'; const r = pn.getBoundingClientRect(); if (r.right > document.documentElement.clientWidth - 8) { pn.style.left = 'auto'; pn.style.right = '0'; } };
      const open = (dd: HTMLElement, hover = false) => { dds.forEach((o) => o !== dd && close(o)); dd.dataset.open = ''; if (hover) dd.dataset.hover = ''; else delete dd.dataset.hover; trig(dd).setAttribute('aria-expanded', 'true'); place(dd); };
      dds.forEach((dd) => {
        const t = trig(dd); let to: ReturnType<typeof setTimeout> | undefined;
        dd.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'mouse') return; clearTimeout(to); if (!('open' in dd.dataset)) open(dd, true); });
        dd.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'mouse' || !('hover' in dd.dataset)) return; to = setTimeout(() => close(dd), 200); });
        t.addEventListener('click', () => { clearTimeout(to); if ('open' in dd.dataset && !('hover' in dd.dataset)) close(dd); else open(dd); });
        t.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); open(dd); links(dd)[0]?.focus(); } });
        dd.addEventListener('keydown', (e) => {
          const l = links(dd); const i = l.indexOf(document.activeElement as HTMLAnchorElement);
          if (e.key === 'Escape' && 'open' in dd.dataset) { close(dd); t.focus(); }
          else if (i >= 0 && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) { e.preventDefault(); l[(i + (e.key === 'ArrowDown' ? 1 : l.length - 1)) % l.length].focus(); }
          else if (i >= 0 && (e.key === 'Home' || e.key === 'End')) { e.preventDefault(); l[e.key === 'Home' ? 0 : l.length - 1].focus(); }
        });
        dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) close(dd); });
      });
      // pointerdown et non click : Safari sur iPad n'émet pas de click sur une zone non cliquable.
      document.addEventListener('pointerdown', (e) => { if (!(e.target as HTMLElement).closest('.nav-dropdown')) dds.forEach(close); });
      const toggle = document.getElementById('mobile-menu-toggle'); const menu = document.getElementById('mobile-menu');
      const setMobile = (on: boolean) => { menu?.classList.toggle('hidden', !on); toggle?.setAttribute('aria-expanded', String(on)); document.documentElement.classList.toggle('menu-open', on); };
      toggle?.addEventListener('click', () => setMobile(menu?.classList.contains('hidden') ?? false));
      document.querySelectorAll<HTMLButtonElement>('.mobile-section-toggle').forEach((btn) => btn.addEventListener('click', () => { const c = btn.nextElementSibling; const on = c?.classList.toggle('hidden') === false; btn.setAttribute('aria-expanded', String(on)); btn.querySelector('.mobile-chevron')?.classList.toggle('rotate-180', on); }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) { setMobile(false); toggle?.focus(); } });
      matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches) setMobile(false); });
    </script>
    <ConsentBanner lang={lang} />
  </body>
</html>
