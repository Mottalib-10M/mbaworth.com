---
import { LANG_TAGS as __LT } from '../data/site-config';
import { displayDate } from '../lib/format';
import BaseLayout from './BaseLayout.astro';
import { YEAR, LAST_UPDATED, AUTHOR_NAME, AUTHOR_ROLE } from '../data/site-config';
import { t } from '../i18n/ui';
import { route, type Locale } from '../i18n/routes';
import type { FAQItem } from '../lib/seo';
interface BreadcrumbItem { label: string; href?: string }
interface Props { title: string; description: string; lang: Locale; canonical?: string; ogImage?: string; noindex?: boolean; jsonLd?: string[]; related?: Array<{ href: string; name: string; description: string }>; faqs?: FAQItem[]; sources?: Array<{ name: string; url: string }>; breadcrumbs?: BreadcrumbItem[]; showAuthor?: boolean; dateEnHaut?: boolean; anneeEnHaut?: boolean; masthead?: boolean }
const { title, description, lang, canonical, ogImage, noindex = false, jsonLd = [], related = [], faqs = [], sources = [], breadcrumbs = [], showAuthor = true, dateEnHaut = false, anneeEnHaut = false, masthead = false } = Astro.props;
const ui = t(lang);
---
<BaseLayout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} breadcrumbs={breadcrumbs} masthead={masthead}>
  {/* Date de mise à jour à droite, sur la ligne fine du fil d'Ariane, même sans fil d'Ariane ; seule sur sa ligne,
       elle laissait ≈ 100 px de blanc avant le titre (RECETTE §10.3, check-layout 13). */}
  {/* Date en haut seulement sur une page de lecture (dateEnHaut) : sur un simulateur ou un accueil
       elle repoussait le titre sans rien apprendre ; elle reste en bas de page et dans dateModified (RECETTE §8.4). */}
  {dateEnHaut && <p slot="crumb-aside" data-chrome class="crumb-note ml-auto text-sm text-navy-600">{ui.updatedOn} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time></p>}
  {/* Sans date en haut, l'année des barèmes reste visible au-dessus du simulateur quand le titre ne la donne pas
       (RECETTE §8.4) : sur la ligne fine du fil d'Ariane, elle ne repousse rien. */}
  {!dateEnHaut && anneeEnHaut && <p slot="crumb-aside" data-chrome class="crumb-note ml-auto text-sm text-navy-600">{`${YEAR} figures`}</p>}
  <div class={`mx-auto max-w-6xl px-4 pb-8 ${masthead ? '' : 'pt-3'}`}>
    <slot />
    {faqs.length > 0 && (<section class="mt-16" id="faq"><h2 class="mb-6 font-serif text-3xl text-navy-900">{ui.faqTitle}</h2><div>
      {faqs.map((faq) => (<details class="faq-item group"><summary class="flex cursor-pointer items-center justify-between gap-6 py-4 font-medium text-navy-900 hover:text-accent-700"><span>{faq.q}</span><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-navy-300 text-navy-600 transition-transform group-open:rotate-45" aria-hidden="true"><svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4v12M4 10h12" stroke-linecap="round" /></svg></span></summary><div class="max-w-3xl pb-5 text-navy-700"><p>{faq.a}</p></div></details>))}
    </div></section>)}
    {related.length > 0 && (<section class="mt-16" data-chrome><h2 class="mb-6 font-serif text-3xl text-navy-900">{ui.relatedCalculators}</h2><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((r) => (<a href={r.href} class="tile tile-link group flex flex-col p-5"><h3 class="font-serif text-lg text-navy-900 group-hover:text-accent-700">{r.name}</h3><p class="mt-1.5 flex-1 text-sm text-navy-600">{r.description}</p><span class="mt-3 text-accent-700 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></a>))}
    </div></section>)}
    {sources.length > 0 && (<section class="mt-16" data-chrome><h2 class="section-title mb-4 font-serif text-xl text-navy-900">{ui.sourcesTitle}</h2><ol class="grid gap-x-8 gap-y-2 text-sm text-navy-700 [overflow-wrap:anywhere] md:grid-cols-2">{sources.map((s, i) => <li class="flex gap-3"><span class="rank-num w-5 shrink-0 text-right">{i + 1}</span><a href={s.url} target="_blank" rel="nofollow noopener noreferrer" class="underline decoration-navy-300 underline-offset-2 hover:text-accent-700">{s.name}</a></li>)}</ol></section>)}
    {showAuthor && (<div data-chrome data-author={AUTHOR_NAME} class="tile mt-12 flex items-center gap-5 px-5 py-5"><span class="seal" aria-hidden="true">RP</span><div class="text-sm"><p class="font-semibold text-navy-900">{ui.writtenBy} <a rel="author" href={route('about', lang)} class="text-accent-700 underline-offset-2 hover:underline">{AUTHOR_NAME}</a></p><p class="text-navy-600">{AUTHOR_ROLE[lang]}</p><p class="mt-1 text-navy-600">{ui.updatedOn} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time> · <a href={route('editorial', lang)} class="text-accent-700 underline-offset-2 hover:underline">{ui.editorialPolicy}</a> · <a href={route('contact', lang)} class="text-accent-700 underline-offset-2 hover:underline">{ui.contactLabel}</a></p></div></div>)}
    <p data-chrome class="mt-4 text-sm text-navy-600">{ui.estimate}</p>
    <p data-chrome class="mt-2 text-sm text-navy-500">{ui.asOf} {YEAR}, {ui.lastUpdated} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time></p>
  </div>
</BaseLayout>
